# VisualClaudeCode configuration — copy to .env and fill in.
# .env is gitignored; never commit real values.

# Bind address of the app itself. Keep it on loopback: TLS and exposure are
# handled by the fronting layer (Cloudflare Tunnel).
VC_HOST=127.0.0.1
VC_PORT=7788
# 1 = serve TLS directly with certs/cert.pem (legacy/standalone mode)
VC_TLS=0

# Auth mode:
#   local      — username/password accounts (+optional TOTP/WebAuthn 2FA)
#   cloudflare — identity from Cloudflare Access JWT (Zero Trust). The app
#                validates the JWT signature/audience/issuer on every request.
VCC_AUTH=cloudflare

# === Admin control — SENSITIVE ===============================================
# Comma-separated emails that get the admin panel. In cloudflare mode this is
# the ONLY thing that grants admin — it is re-checked from this list on every
# request, so anyone you add here becomes a full admin (can create users, turn
# OFF a user's sandbox = give them a root shell on this host, raise session
# limits, etc.). Keep it to identities you fully trust; changing it takes
# effect on the user's next request after a service restart.
VCC_ADMIN_EMAILS=

# === Deployment inputs (scripts/deploy.py reads these) =======================
CLOUDFLARE_API_TOKEN=          # scoped token, see docs/cloudflare.md
VCC_ZONE=example.com         # apex domain on Cloudflare
VCC_HOSTNAME=vcc.example.com # public hostname to serve
VCC_TUNNEL_NAME=vcc            # tunnel name
# Access allow-list (who may reach the app at all). Defaults to
# VCC_ADMIN_EMAILS if unset. Being allowed here is NOT the same as being admin.
VCC_ALLOWED_EMAILS=

# === Filled in automatically by scripts/deploy.py ============================
# your Zero Trust team domain, e.g. myteam.cloudflareaccess.com
VCC_ACCESS_TEAM_DOMAIN=
# the Access application's Application Audience (AUD) tag
VCC_ACCESS_AUD=
